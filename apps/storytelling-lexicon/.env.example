# Supabase project (Settings -> API). Without these the app runs in preview
# mode: the glossary reads from the bundled seed data and the catalog is off.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only used by `pnpm seed` and `pnpm import:tvtropes`. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL, used for magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where quotes are stored. A local SQLite file by default; point this at a
# Turso/libSQL database (libsql://...) when you deploy so web and iOS share data.
DATABASE_URL=file:./data/library.db
# DATABASE_AUTH_TOKEN=

# Shared secret for the web login and the iOS app / Shortcuts (Bearer token).
# Leave unset to disable auth during local development.
FACETS_API_TOKEN=change-me
